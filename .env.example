# --- Database -------------------------------------------------------------
# Runtime connection. For a cloud Postgres with a pooler (Neon, Supabase…)
# use the *pooled* URL and add `pgbouncer=true`, e.g.
#   postgresql://user:pass@ep-xyz-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/workshop_registration"

# Direct (non-pooled) connection, used only by `prisma migrate`.
# Locally this is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/workshop_registration"

# Disposable database for `npm test`. The suite TRUNCATES tables, so it must
# never point at real data. On a single cloud DB, use a separate schema:
#   ...same url...&schema=test
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/workshop_registration_test"

# --- App ------------------------------------------------------------------
# All three locations share one timezone. Used to display times, interpret
# the date-time inputs and compute "this week".
NEXT_PUBLIC_APP_TIMEZONE="Europe/London"

# Public URL of the deployment (used for link previews / Open Graph).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side inactivity timeout for sessions (days).
SESSION_TTL_DAYS=7

# Show the demo-account shortcuts on the login page in a production build
# (they always show in development). Never enable this for real data.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
